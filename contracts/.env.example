# Copy to .env for local use. Never commit the populated file.
SEPOLIA_RPC_URL=https://your-sepolia-rpc.example
# Each private key is 64 hexadecimal characters, plus an optional 0x prefix.
# Use demo-only private keys—not 42-character public wallet addresses.
NGO_PRIVATE_KEY=0x<64-hex-character-demo-private-key>
REVIEWER_PRIVATE_KEY=0x<64-hex-character-demo-private-key>
